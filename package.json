{
  "name": "zyroxcssv2",
  "version": "2.1.1",
  "scripts": {
    "build:css": "npx sass src/scss/zyroxcss.scss dist/css/zyroxcss.css",
    "build:js": "cp src/js/zyroxcss.js dist/js/zyroxcss.js",
    "postcss": "npx postcss dist/css/zyroxcss.css --use autoprefixer -o dist/css/zyroxcss.css",
    "build": "mkdir -p dist/js && npm run build:css && npm run build:js && npm run postcss"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.5",
    "cssnano": "^8.0.2",
    "postcss": "^8.5.28",
    "postcss-cli": "^8.3.1",
    "sass": "^1.0.0"
  },
  "files": [
    "dist/"
  ]
}
